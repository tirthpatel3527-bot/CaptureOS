{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaptureOS MagicSearchBench dataset manifest",
  "type": "object",
  "required": ["formatVersion", "type", "datasets"],
  "properties": {
    "formatVersion": { "const": 1 },
    "type": { "const": "BenchmarkDatasetManifest" },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "source",
          "license",
          "containsCustomerMedia",
          "containsIdentityLabels",
          "derivation"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "checksum": { "type": ["string", "null"] },
          "derivation": { "type": "string", "minLength": 1 },
          "containsCustomerMedia": { "const": false },
          "containsIdentityLabels": { "const": false }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

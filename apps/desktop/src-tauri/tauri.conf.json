{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaptureOS",
  "version": "0.1.0",
  "identifier": "com.captureos.desktop",
  "build": {
    "beforeDevCommand": "cd .. && npm run dev",
    "beforeBuildCommand": "cd .. && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "CaptureOS", "width": 900, "height": 660, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' captureos-preview: http://captureos-preview.localhost"
    }
  },
  "bundle": { "active": true, "targets": "all" }
}
